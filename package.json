{
  "name": "serial-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Web serial monitor (Node + WebSocket + React)",
  "scripts": {
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix frontend run dev",
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "npm --prefix frontend run build",
    "build": "npm run build:client",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "start": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "3.9.6"
  }
}
